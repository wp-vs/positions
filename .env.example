# EODHD API key (required for price data)
# Get your key at https://eodhd.com/
EODHD_API_KEY=your_eodhd_api_key_here

# SMTP configuration for --email flag
# Copy this to .env and fill in your details, then:
#   export $(cat .env | xargs)  # Linux/Mac
#   # or set them in your shell/system environment

# --- ProtonMail Bridge (runs locally) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=your.email@pm.me
SMTP_PASS=your-bridge-password
SMTP_USE_TLS=true

# --- Gmail example ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_USE_TLS=true

# --- Sender and recipient ---
EMAIL_FROM=your.email@pm.me
EMAIL_TO=will.pri@pm.me
